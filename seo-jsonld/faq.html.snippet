        {
          "@type": "Question",
          "name": "What is included in a free consultation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A free consultation is a one-hour meeting that can include a studio tour, a conversation about your project, and pricing guidance. You can select an available time through the Checkmark Audio calendar."
          }
        },
        {
          "@type": "Question",
          "name": "Do you work with first-time or beginner artists?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Checkmark Audio works with artists of all experience levels, including first-time and beginner artists."
          }
        },
        {
          "@type": "Question",
          "name": "What file formats do I get back after mixing or mastering?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "High-resolution WAV and MP3 files. Stem or raw-file delivery can be included in the project quote or approved as an additional service."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer remote mixing and mastering?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. You may send your stems or a download link by email, and Checkmark Audio can complete the mixing or mastering work remotely. File preparation, price, and delivery details are confirmed for the project before work begins."
          }
        },
        {
          "@type": "Question",
          "name": "What should I bring to my session?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bring anything relevant to the project: reference tracks, stems or DAW project files, prior work, instruments, and any unique gear you need. For work beginning from existing recordings, WAV stems are recommended."
          }
