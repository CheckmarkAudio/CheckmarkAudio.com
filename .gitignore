.DS_Store
Thumbs.db
.claude/settings.local.json

# Local-only raw exports and temporary intake.
ARCHIVE/ignored-local/

# Legacy raw-export locations, kept ignored if old tooling recreates them.
wix-export/*.har
wix-export/*.rtf
original-assets/
wix-export/
migration/public-pages/

# Full-resolution source photos (~2GB). Master library for color edits —
# only the exported MEDIA/IMAGES/*.webp outputs are meant to be tracked.
MEDIA/ORIGINALS/

# Timestamped backups written before each media-editor save (local safety net).
.media-backups/

# Python bytecode from scripts/.
__pycache__/

# Existing local-only masters: storage/permission decisions are still pending.
# Optimized demo-clips/*.mp3 and the comparison .m4a files remain tracked.
/MEDIA/AUDIO/*.mp3
/MEDIA/AUDIO/*.wav
/MEDIA/VIDEO/

# Unlicensed texture inspiration and transient Affinity lock files are not web assets.
/MEDIA/IMAGES/TEXTURES/REFERENCE/
*.af~lock~
